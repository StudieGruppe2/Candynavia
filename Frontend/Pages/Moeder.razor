@page "/moeder"
@inject HttpClient Http

<PageTitle>Mødeanmodninger</PageTitle>

<h1>Mødeanmodninger</h1>

@if (fejl is not null)
{
    <p class="fejl">@fejl</p>
}

<section class="kort">
    <h2>Ny anmodning</h2>
    <EditForm Model="ny" OnValidSubmit="Opret">
        <DataAnnotationsValidator />
        <label>Titel <InputText @bind-Value="ny.Titel" /></label>
        <ValidationMessage For="() => ny.Titel" />

        <label>Deltager <InputText @bind-Value="ny.Deltager" /></label>
        <ValidationMessage For="() => ny.Deltager" />

        <label>Dato <InputDate @bind-Value="ny.Dato" /></label>

        <label>Beskrivelse <InputTextArea @bind-Value="ny.Beskrivelse" rows="3" /></label>

        <button type="submit" class="knap">Send anmodning</button>
    </EditForm>
</section>

<section>
    <h2>Alle anmodninger</h2>
    @if (moeder is null)
    {
        <p>Henter...</p>
    }
    else if (moeder.Count == 0)
    {
        <p>Der er ingen anmodninger endnu.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Dato</th><th>Titel</th><th>Deltager</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var m in moeder)
                {
                    <tr>
                        <td>@m.Dato.ToString("dd-MM-yyyy")</td>
                        <td>@m.Titel</td>
                        <td>@m.Deltager</td>
                        <td><span class="status @m.Status.ToString().ToLower()">@m.Status</span></td>
                        <td class="handlinger">
                            @if (m.Status == MoedeStatus.Afventer)
                            {
                                <button @onclick="() => SaetStatus(m.Id, MoedeStatus.Godkendt)">Godkend</button>
                                <button @onclick="() => SaetStatus(m.Id, MoedeStatus.Afvist)">Afvis</button>
                            }
                            <button class="slet" @onclick="() => Slet(m.Id)">Slet</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private List<MoedeAnmodning>? moeder;
    private MoedeAnmodning ny = new();
    private string? fejl;

    protected override async Task OnInitializedAsync() => await Hent();

    private async Task Hent()
    {
        try
        {
            moeder = await Http.GetFromJsonAsync<List<MoedeAnmodning>>("api/moeder");
            fejl = null;
        }
        catch (HttpRequestException)
        {
            moeder = new();
            fejl = "Kunne ikke kontakte backend. Kører Backend-projektet?";
        }
    }

    private async Task Opret()
    {
        await Http.PostAsJsonAsync("api/moeder", ny);
        ny = new();
        await Hent();
    }

    private async Task SaetStatus(int id, MoedeStatus status)
    {
        await Http.PutAsJsonAsync($"api/moeder/{id}/status", status);
        await Hent();
    }

    private async Task Slet(int id)
    {
        await Http.DeleteAsync($"api/moeder/{id}");
        await Hent();
    }
}
