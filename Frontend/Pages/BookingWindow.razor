@inject HttpClient Http

@if (SalesPerson != null)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-box" @onclick:stopPropagation="true">

            <button class="modal-close" @onclick="Close">✕</button>

            <p class="overline">BOOK MØDE</p>
            <h2>@SalesPerson.Name</h2>
            <p>@SalesPerson.Position · @SalesPerson.Email · @SalesPerson.Phone</p>

            @if (isSent)
            {
                <p class="message-success">Tak! Din mødeforespørgsel er sendt til @SalesPerson.Name.</p>
                <button class="btn-primary" @onclick="Close">Luk</button>
            }
            else
            {
                <!-- 1. Vælg tidspunkt -->
                <h3>Vælg et tidspunkt</h3>
                @if (timeSlots == null)
                {
                    <p>Henter ledige tider...</p>
                }
                else if (timeSlots.Count == 0)
                {
                    <p>Sælgeren har ingen ledige tider lige nu.</p>
                }
                else
                {
                    <div class="time-slots">
                        @foreach (TimeSlot slot in timeSlots)
                        {
                            <button class="time-slot @(selectedTimeSlot?.TimeSlot_Id == slot.TimeSlot_Id ? "selected" : "")"
                                    @onclick="() => selectedTimeSlot = slot">
                                @slot.StartTime.ToString("dd/MM HH:mm") – @slot.EndTime.ToString("HH:mm")
                            </button>
                        }
                    </div>
                }

                <!-- 2. Kundens oplysninger -->
                @if (selectedTimeSlot != null)
                {
                    <h3>Dine oplysninger</h3>
                    <input placeholder="Navn" @bind="request.Customer.Name" />
                    <input placeholder="Email" @bind="request.Customer.Email" />
                    <input placeholder="Telefon" @bind="request.Customer.Phone" />
                    <input placeholder="Virksomhed" @bind="request.Customer.Company" />
                    <input placeholder="Stilling" @bind="request.Customer.Position" />
                    <textarea placeholder="Hvad vil du gerne tale om?" @bind="request.Description"></textarea>

                    <label class="consent">
                        <input type="checkbox" @bind="request.Consent" />
                        Jeg giver samtykke til, at mine oplysninger må bruges til at kontakte mig
                    </label>

                    @if (errorMessage != null)
                    {
                        <p class="message-error">@errorMessage</p>
                    }

                    <button class="btn-primary" @onclick="Submit">Send forespørgsel</button>
                }
            }
        </div>
    </div>
}

@code {
    // Sælgeren, der er valgt på siden - modalen er åben, når den ikke er null
    [Parameter] public SalesPerson? SalesPerson { get; set; }

    // Kaldes, når modalen lukkes, så siden kan sætte SalesPerson til null
    [Parameter] public EventCallback OnClose { get; set; }

    private List<TimeSlot>? timeSlots;
    private TimeSlot? selectedTimeSlot;
    private MeetingRequest request = new MeetingRequest();
    private string? errorMessage;
    private bool isSent;

    // Køres, hver gang der vælges en ny sælger
    protected override async Task OnParametersSetAsync()
    {
        if (SalesPerson == null) return;

        // Nulstiller modalen
        timeSlots = null;
        selectedTimeSlot = null;
        request = new MeetingRequest();
        errorMessage = null;
        isSent = false;

        // Henter sælgerens ledige tider fra backend
        timeSlots = await Http.GetFromJsonAsync<List<TimeSlot>>(
            $"TimeSlot/salesperson/{SalesPerson.SalesPerson_Id}");
    }

    private async Task Submit()
    {
        request.TimeSlot_Id = selectedTimeSlot!.TimeSlot_Id;
        request.SalesPerson_Id = SalesPerson!.SalesPerson_Id;

        HttpResponseMessage response = await Http.PostAsJsonAsync("MeetingRequest", request);

        if (response.IsSuccessStatusCode)
        {
            isSent = true;
        }
        else
        {
            errorMessage = "Forespørgslen kunne ikke sendes. Tjek at alle felter er udfyldt, og at du har givet samtykke.";
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();
}