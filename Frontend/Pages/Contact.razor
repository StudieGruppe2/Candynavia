@page "/"

<div class="contact-container">

    <p class="overline">KONTAKT OS</p>

    <h1>Find og kontakt en sælger</h1>

    <p>
        Find den ansvarlige sælger i dit område, se kontaktoplysninger
        og book et møde på et tidspunkt, der passer dig.
    </p>

    <!--Fælles container til Danmarkskort og søgning-->
    <div class="sales-container">
        <!--Danmarkskort med salgsområderne og sælgere-->
        <div class="map-container">
            <img src="Pictures/CandynaviaDKKort.png"
                 alt="Danmarkskort over Candynavias salgsområder"
                 class="sales-map" />
        </div>
       
        <!--Boks til søgning efter sælger-->
        <div class="Search-container">
            <h2>Find din lokale sælger</h2>
            <p>
                Indtast dit postnummer, så finder vi den rette
                kontaktperson til dig.
            </p>
            <div class="Searchline">
                <input type="text"
                       placeholder="Indtast postnummer"
                       maxlength="4"
                       @bind-value="PostalCode" />
                <div>
                    <button class="btn-primary"
                            @onclick="() => SeeSalesPersonByPostalCode(PostalCode)">
                        Find din sælger
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private string PostalCode = ""; //gemmer postnummeret fra søgefeltet
    
    //Finder sælgeren ud fra det indtastede postnummer
    private async Task SeeSalesPersonByPostalCode(string PostalCode)
    {
   
    }
}