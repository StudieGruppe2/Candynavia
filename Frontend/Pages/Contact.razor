@page "/"
@inject HttpClient Http

<div class="contact-container">

    <p class="overline">KONTAKT OS</p>

    <h1>Find og kontakt en sælger</h1>

    <p>
        Find den ansvarlige sælger i dit område, se kontaktoplysninger og anmod om et møde på et tidspunkt, der passer dig.
    </p>

    <!--Fælles container til Danmarkskort og søgning-->
    <div class="sales-container">
        <!--Danmarkskort med salgsområderne og sælgere-->
        <div class="map-container">
            <img src="Pictures/CandynaviaDKKort.png"
                 alt="Danmarkskort over Candynavias salgsområder"
                 class="sales-map" />
        </div>

        <!--Boks til søgning efter sælger-->
        <div class="Search-container">
            <h2>Find din lokale sælger</h2>
            <p>
                Indtast dit postnummer, så finder vi den rette
                kontaktperson til dig.
            </p>
            <div class="Searchline">
                <input type="text"
                       placeholder="Indtast postnummer"
                       maxlength="4"
                       @bind-value="postalCode" />
                <div>
                    <button class="btn-primary"
                            @onclick="() => SeeSalesPersonByPostalCode(postalCode)">
                        Find din sælger
                    </button>
                </div>
            </div>

            <!--Fejlbesked, hvis der ikke findes en sælger-->
            @if (errorMessage != null)
            {
                <p class="message-error">@errorMessage</p>
            }

            <!--Den fundne sælger vises under søgningen-->
            @if (salesPerson != null)
            {
                <div class="salesperson-result">
                    <p class="overline">DIN SÆLGER</p>
                    <h3>@salesPerson.Name</h3>
                    <p>@salesPerson.Position</p>
                    <p>@salesPerson.Email<br />@salesPerson.Phone</p>

                    <button class="btn-primary" @onclick="() => selectedSalesPerson = salesPerson">
                        Anmod om et møde
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!--Viser bookingvinduet og sender den valgte sælger til komponenten. Når vinduet lukkes, kaldes OnClose, som sætter selectedSalesPerson til null, så bookingvinduet ikke længere vises-->
<!-- Opretter først bookingvinduet, når en sælger er valgt -->
@if (selectedSalesPerson != null)
{
<RequestWindow SalesPerson="selectedSalesPerson"OnClose="() => selectedSalesPerson = null" />
}

@code {
    private string postalCode = ""; //Gemmer postnummeret fra søgefeltet
    private SalesPerson? salesPerson; //Den fundne sælger
    private SalesPerson? selectedSalesPerson; //Den sælger, kunden ønsker at booke hos
    private string? errorMessage; //Fejlbesked til brugeren

    // Finder sælgeren ud fra det indtastede postnummer
    private async Task SeeSalesPersonByPostalCode(string postalCode)
    {
        errorMessage = null;
        salesPerson = null;

        //Sender en HTTP GET-request til backend
        HttpResponseMessage response = await Http.GetAsync($"SalesPerson/postalcode/{postalCode}");

        //Kontrollerer, om backend har fundet en sælger
        if (response.IsSuccessStatusCode)
        {
            //Omdanner JSON-svaret til et SalesPerson-objekt, så vi kan tilgå sælgerens oplysninger
            salesPerson = await response.Content.ReadFromJsonAsync<SalesPerson>();
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            errorMessage = "Vi kunne ikke finde en sælger til det postnummer.";
        }
        else
        {
            errorMessage = "Der opstod en fejl. Prøv igen senere.";
        }
    }

}